  "narrative": {
    "northStar": "The Spatial Library",
    "overview": "A dark, space-inspired desktop library. Colored subject clusters supply the atmosphere and orientation; restrained HUD surfaces keep browsing, reading, and source retrieval familiar. The library remains visible as light points behind the working interface.\n\nKeep the interface compact and quiet for sustained use. The spatial treatment supports real library content: placement is illustrative and subject-based, not a semantic embedding visualization. Preview resources remain explicitly identified; the interface must not imply OCR, embeddings, or generated explanations are available.",
    "keyCharacteristics": [
      "Deep-space background with readable translucent work surfaces.",
      "A visible subject map and independently collapsible side panels.",
      "Concise controls, restrained cyan actions, and consistent subject identity."
    ],
    "rules": [
      {
        "name": "The Subject Identity Rule",
        "body": "Reuse each subject’s actual color across surfaces; do not recolor clusters for visual balance.",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "Establish priority through weight, spacing, and contrast before increasing type size.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the library map visible around readable work surfaces.",
      "Do preserve independent panel collapse and clear keyboard focus.",
      "Do bind subject markers, legends, and spatial nodes to the same subject colors.",
      "Do distinguish real source content from labeled previews and illustrative placement."
    ],
    "donts": [
      "Don’t add slogans, decorative introductions, fake telemetry, coordinates, or workspace breadcrumbs.",
      "Don’t replace the spatial library with a generic card dashboard.",
      "Don’t imply semantic embeddings, OCR, LLM explanations, or evidence beyond the local library exist.",
      "Don’t claim a phone layout below the implemented desktop minimum."
    ]
  }
