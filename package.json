{
  "name": "speculib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node electron/dev.cjs\"",
    "start": "electron .",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.cjs",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs",
    "benchmark:retrieval": "node --experimental-strip-types scripts/retrieval-benchmark.mjs",
    "benchmark:ui": "npm run build && node scripts/retrieval-ui-benchmark.mjs",
    "test:ollama": "node --experimental-strip-types scripts/ollama-smoke.mjs",
    "test:ollama-ui": "npm run build && node scripts/ollama-ui-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "playwright": "^1.65.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
